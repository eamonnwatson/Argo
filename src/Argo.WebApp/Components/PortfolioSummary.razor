@namespace Argo.WebApp.Components

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4 stat-card" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Class="stat-label">Waiting</MudText>
                <MudText Typo="Typo.h5" Class="stat-value">@Projects.Count(p => p.Status == "Waiting")</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4 stat-card" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Class="stat-label">In progress</MudText>
                <MudText Typo="Typo.h5" Class="stat-value">@Projects.Count(p => p.Status == "In Progress")</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4 stat-card" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Class="stat-label">Done</MudText>
                <MudText Typo="Typo.h5" Class="stat-value">@Projects.Count(p => p.Status == "Done")</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public List<ProjectDTO> Projects { get; set; } = [];
    [Parameter, EditorRequired] public List<WorkItemDTO> WorkItems { get; set; } = [];
    [Parameter, EditorRequired] public List<RaidItemDTO> RaidItems { get; set; } = [];
}
