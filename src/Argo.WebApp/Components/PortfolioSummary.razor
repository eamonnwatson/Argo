@namespace Argo.WebApp.Components

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4 stat-card" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Class="stat-label">Waiting</MudText>
                <MudText Typo="Typo.h5" Class="stat-value">@CountWaiting</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4 stat-card" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Class="stat-label">In progress</MudText>
                <MudText Typo="Typo.h5" Class="stat-value">@CountInProgress</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4 stat-card" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Class="stat-label">Done</MudText>
                <MudText Typo="Typo.h5" Class="stat-value">@CountDone</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public int CountWaiting { get; set; } = 0;
    [Parameter] public int CountInProgress { get; set; } = 0;
    [Parameter] public int CountDone { get; set; } = 0;
}
