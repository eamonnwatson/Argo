@namespace Argo.WebApp.Components

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.caption">Total projects</MudText>
            <MudText Typo="Typo.h5">@Projects.Count</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.caption">Waiting</MudText>
            <MudText Typo="Typo.h5">@Projects.Count(p => p.Status == "Waiting")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.caption">In progress</MudText>
            <MudText Typo="Typo.h5">@Projects.Count(p => p.Status == "In Progress")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.caption">At risk / blocked</MudText>
            <MudText Typo="Typo.h5" Color="Color.Error">@Projects.Count(p => p.Health is "At Risk" or "Blocked")</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public List<ProjectDTO> Projects { get; set; } = [];
    [Parameter, EditorRequired] public List<WorkItemDTO> WorkItems { get; set; } = [];
    [Parameter, EditorRequired] public List<RaidItemDTO> RaidItems { get; set; } = [];
}
