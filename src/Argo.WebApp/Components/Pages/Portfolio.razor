@page "/"

<PageTitle>Argo Portfolio</PageTitle>

<MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddProjectDialog">Add project</MudButton>
</MudStack>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{    
    <PortfolioSummary CountWaiting="@projects.Count(p => p.Status == "Waiting")" CountInProgress="@projects.Count(p => p.Status == "In Progress")" CountCompleted="@projects.Count(p => p.Status == "Completed")" />

    
    <TeamWorkloadChart Projects="projects" Users="users" />

    <PortfolioBoard Projects="projects" />
    
}
