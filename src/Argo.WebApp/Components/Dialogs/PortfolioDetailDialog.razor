@namespace Argo.WebApp.Components

<MudContainer Fixed="true" Class="pa-0">
    <MudPaper Class="detail-panel" Elevation="0">
        <div class="detail-head">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
            <div>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-2">
                    <span class="project-id" style="color:var(--brand-cyan);">@Project.Id</span>
                    <MudChip T="string" Size="Size.Small" Color="@ProjectStatusColor(Project.Status)">@Project.Status</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="@PriorityColor(Project.Priority)">@Project.Priority priority</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="@HealthColor(Project.Health)">@Project.Health</MudChip>
                </MudStack>
                <MudText Typo="Typo.h5" Style="color:#fff;">@Project.Name</MudText>
                @if (!string.IsNullOrWhiteSpace(Project.Objective))
                {
                    <MudText Typo="Typo.body2" Class="objective">@Project.Objective</MudText>
                }
            </div>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditProject">Edit project</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete">Delete project</MudButton>
            </MudStack>
        </MudStack>

        <div class="facts">
            <div>
                <div class="fact-label">Project owner</div>
                <div class="fact-value">@Project.Owner</div>
            </div>
            <div>
                <div class="fact-label">Next milestone</div>
                <div class="fact-value">@(string.IsNullOrWhiteSpace(Project.NextMilestone) ? "—" : Project.NextMilestone)</div>
            </div>
            <div>
                <div class="fact-label">Target date</div>
                <div class="fact-value">@Project.TargetDate.ToString("MMM d, yyyy")</div>
            </div>
            <div>
                <div class="fact-label">Waves completed</div>
                <div class="fact-value">@WavesCompletedPercent% (@WavesDone/@WavesTotal)</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Project.SourceRequestId))
    {
        <div class="intake-banner">
            <span>Submitted request &middot; @Project.SourceRequestId</span>
            <button class="edit-link" type="button" @onclick="ToggleIntakeDetails">
                Original intake details @(intakeExpanded ? "−" : "+")
            </button>
        </div>
        @if (intakeExpanded)
        {
            <div class="intake-details">@(string.IsNullOrWhiteSpace(Project.IntakeDetails) ? "No additional intake details." : Project.IntakeDetails)</div>
        }
    }

    <MudGrid Class="pa-4">
        <MudItem xs="12" md="7">
            <div class="section-title">
                <div>
                    <MudText Typo="Typo.subtitle1">Work packages and waves</MudText>
                    <MudText Typo="Typo.caption">Expand each item for participants, inputs, milestones, and completion criteria.</MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add">Add wave</MudButton>
            </div>

            @if (workItems.Count == 0)
            {
                <div class="empty-hint">No work packages yet.</div>
            }
            else
            {
                <div class="work-list">
                    @foreach (var item in workItems)
                    {
                        var expanded = expandedWorkItemIds.Contains(item.WorkItemId);
                        var (done, total) = ActivityProgress(item.WorkItemId);
                        <div class="@($"work-package {(expanded ? "expanded" : "")}")">
                            <div class="work-summary">
                                <button class="work-toggle" type="button" @onclick="() => ToggleWorkItem(item.WorkItemId)">
                                    <span class="chevron">&rsaquo;</span>
                                    <span>
                                        <span class="work-title">@item.Title</span>
                                        <span class="work-subtext">@item.WorkItemId &middot; @done/@total activities complete</span>
                                    </span>
                                </button>
                                <div>
                                    <div class="fact-label">Owner</div>
                                    <div>@item.Owner</div>
                                </div>
                                <div>
                                    <div class="fact-label">Status</div>
                                    <MudChip T="string" Size="Size.Small" Color="@WorkStatusColor(item.Status)">@item.Status</MudChip>
                                </div>
                                <div>
                                    <div class="fact-label">Due</div>
                                    <div>@item.DueDate.ToString("MMM d, yyyy")</div>
                                </div>
                                <button class="edit-link" type="button" @onclick="">Edit</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </MudItem>

        <MudItem xs="12" md="5">
            <div class="section-title">
                <div>
                    <MudText Typo="Typo.subtitle1">RAID and decisions</MudText>
                    <MudText Typo="Typo.caption">What needs attention or leadership input.</MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add">Add record</MudButton>
            </div>

            @if (raidItems.Count == 0)
            {
                <div class="empty-hint">No RAID records yet.</div>
            }
            else
            {
                <div class="raid-list">
                    @foreach (var r in raidItems)
                    {
                        <div class="raid-card">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@r.Type</MudChip>
                            <div class="raid-copy">
                                <strong>@r.Description</strong>
                                <div class="raid-meta">
                                    <span>@r.Owner</span>
                                    <span>@r.DueDate.ToString("MMM d, yyyy")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </MudItem>
    </MudGrid>

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="pa-4 pt-0">
            <MudButton Variant="Variant.Text" OnClick="CloseDialog">Close</MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>
