@using Argo.Application.DTO
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@dialogTitle</MudText>
        <MudText Typo="Typo.caption">Add or update portfolio-level information.</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm Model="model" @ref="form" OnEnterPressed="@(() => form.ValidateAsync())">
            <MudGrid>
                <MudItem md="6" xs="12">
                    <MudTextField @bind-Value="model.Name" Label="Project Name" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem md="6" xs="12">
                    <MudSelect T="string" @bind-Value="model.Owner" Label="Project Owner" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("Unassigned")">Unassigned</MudSelectItem>
                        @foreach (var user in Users)
                        {
                            <MudSelectItem Value="@user.DisplayName">@user.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem md="6" xs="12">
                    <MudSelect T="string" @bind-Value="model.Status" Label="Overall Status" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("Waiting")">Waiting</MudSelectItem>
                        <MudSelectItem Value="@("In Progress")">In Progress</MudSelectItem>
                        <MudSelectItem Value="@("Done")">Done</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem md="6" xs="12">
                    <MudSelect T="string" @bind-Value="model.Health" Label="Health" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("Not Assessed")">Not Assessed</MudSelectItem>
                        <MudSelectItem Value="@("On Track")">On Track</MudSelectItem>
                        <MudSelectItem Value="@("At Risk")">At Risk</MudSelectItem>
                        <MudSelectItem Value="@("Blocked")">Blocked</MudSelectItem>
                        <MudSelectItem Value="@("Complete")">Complete</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem md="6" xs="12">
                    <MudSelect T="string" @bind-Value="model.Priority" Label="Waiting Priority" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("Needs Triage")">Needs Triage</MudSelectItem>
                        <MudSelectItem Value="@("Critical")">Critical</MudSelectItem>
                        <MudSelectItem Value="@("High")">High</MudSelectItem>
                        <MudSelectItem Value="@("Medium")">Medium</MudSelectItem>
                        <MudSelectItem Value="@("Low")">Low</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem md="12">
                    <MudTextField @bind-Value="model.Objective" Label="Objective" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
                <MudItem md="6" xs="12">
                    <MudTextField @bind-Value="model.NextMilestone" Label="Next Milestone" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
                <MudItem md="6" xs="12">
                    <MudDatePicker @bind-Date="model.TargetDate" Label="Target Date" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" Required="true" />
                </MudItem>
            </MudGrid>
            
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save project</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<UserDTO> Users { get; set; } = [];
    [Parameter] public ProjectDTO? Project { get; set; } = null!;

    private class ProjectEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string Owner { get; set; } = "Unassigned";
        public string Status { get; set; } = "Waiting";
        public string Health { get; set; } = "Not Assessed";
        public string Priority { get; set; } = "Needs Triage";
        public string Objective { get; set; } = string.Empty;
        public string NextMilestone { get; set; } = string.Empty;
        public DateTime? TargetDate { get; set; } = DateTime.Today;
    }

    private ProjectEditModel model = new ProjectEditModel();
    private string dialogTitle = "Add project";
    private MudForm form = default!;

    protected override void OnParametersSet()
    {
        if (Project != null)
        {
            model.Name = Project.Name;
            model.Owner = Project.Owner;
            model.Status = Project.Status;
            model.Health = Project.Health;
            model.Priority = Project.Priority;
            model.Objective = Project.Objective;
            model.NextMilestone = Project.NextMilestone;
            model.TargetDate = Project.TargetDate.ToDateTime(TimeOnly.MinValue);
            dialogTitle = "Edit project";
        }
        base.OnParametersSet();
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (form.IsValid)
        {
            if (Project is not null)
            {
                var projectToUpdate = new ProjectDTO(
                    Id: Project.Id,
                    Name: model.Name,
                    Owner: model.Owner,
                    Status: model.Status,
                    Health: model.Health,
                    Priority: model.Priority,
                    Objective: model.Objective,
                    NextMilestone: model.NextMilestone,
                    TargetDate: DateOnly.FromDateTime(model.TargetDate ?? DateTime.Today),
                    SourceRequestId: Project.SourceRequestId,
                    SubmittedAt: Project.SubmittedAt,
                    IntakeDetails: Project.IntakeDetails                   
                );

                MudDialog.Close(DialogResult.Ok(projectToUpdate));
                return;
            }

            var updatedProject = new ProjectCreateDTO(
                Name: model.Name,
                Owner: model.Owner,
                Status: model.Status,
                Health: model.Health,
                Priority: model.Priority,
                Objective: model.Objective,
                NextMilestone: model.NextMilestone,
                TargetDate: DateOnly.FromDateTime(model.TargetDate ?? DateTime.Today) 
            );

            MudDialog.Close(DialogResult.Ok(updatedProject));
        }
    }
}
