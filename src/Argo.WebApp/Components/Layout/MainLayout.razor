@inherits LayoutComponentBase

<MudThemeProvider Theme="@ArgoTheme.Theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Medium" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="hero-banner" Fixed="false" Style="height:auto; padding:18px 0;">
        <div class="shell-row">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <div class="constellation-mark">
                    <MudImage Src="images/argo-constellation.png" ObjectFit="ObjectFit.Cover" Style="width:100%;height:100%;" />
                </div>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Class="hero-eyebrow">Data Strategy &amp; Delivery</MudText>
                    <MudText Typo="Typo.h4">Argo Portfolio</MudText>
                    <MudText Typo="Typo.body2" Class="hero-subtitle mt-1">From direction to destination. One portfolio view connected to project work, dependencies, risks, issues, and decisions.</MudText>
                </MudStack>
            </MudStack>
            <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Class="hero-nav">
                <MudLink Href="" Match="NavLinkMatch.All" Color="Color.Inherit" Underline="Underline.None">Portfolio</MudLink>
                <MudLink Href="intake" Match="NavLinkMatch.Prefix" Color="Color.Inherit" Underline="Underline.None">Intake</MudLink>
            </MudStack>
        </div>
    </MudAppBar>
    <MudMainContent Class="pa-4">
        <MudContainer Fixed="true">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">??</span>
</div>

