@namespace Argo.WebApp.Components

<MudPaper Class="pa-4 mb-4 my-4" Elevation="0" Style="box-shadow:var(--shadow);">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-3">
        <div>
            <MudText Typo="Typo.h6">Team workload &amp; project health</MudText>
            <MudText Typo="Typo.caption" Class="mud-secondary-text">Each project appears once. At Risk and Blocked take precedence so attention items remain visible.</MudText>
        </div>
        <div class="chart-legend">
            @foreach (var category in Categories)
            {
                <span class="legend-item"><span class="legend-dot chart-@category"></span>@category.Replace('-', ' ')</span>
            }
        </div>
    </MudStack>

    <div class="owner-bars">
        @foreach (var owner in Workload)
        {
            <div class="owner-bar-row">
                <div class="owner-name">@owner.Owner</div>
                <div class="owner-track">
                    @foreach (var segment in owner.Segments)
                    {
                        <div class="owner-segment chart-@segment.Category" style="width:@(segment.Percent)%;">@segment.Count</div>
                    }
                </div>
                <div class="owner-total">
                    @owner.Total
                    <span>assigned</span>
                </div>
            </div>
        }
    </div>
</MudPaper>

@code {
    [Parameter] public List<ProjectDto> Projects { get; set; } = [];
    [Parameter] public List<UserDto> Users { get; set; } = [];

    private static readonly string[] Categories = ["Waiting", "In-Progress", "At-Risk", "Blocked", "Done"];

    private record OwnerSegment(string Category, int Count, double Percent);
    private record OwnerWorkload(string Owner, int Total, List<OwnerSegment> Segments);

    private static string Categorize(ProjectDto project)
    {
        if (project.Health == "Blocked")
            return "Blocked";

        if (project.Health == "At Risk")
            return "At-Risk";

        if (project.Status == "Done")
            return "Done";

        if (project.Status == "In Progress")
            return "In-Progress";

        return "Waiting";
    }

    private List<OwnerWorkload> Workload
    {
        get
        {
            var byOwner = Projects.ToLookup(p => p.Owner);

            var owners = Users
                .Select(u => u.Name)
                .Union(Projects.Select(p => p.Owner))
                .Distinct()
                .ToList();

            return owners
                .Select(owner =>
                {
                    var projects = byOwner[owner].ToList();
                    var total = projects.Count;
                    var segments = projects
                        .Select(Categorize)
                        .GroupBy(c => c)
                        .OrderBy(c => Array.IndexOf(Categories, c.Key))
                        .Select(c => new OwnerSegment(c.Key, c.Count(), total == 0 ? 0 : 100.0 * c.Count() / total))
                        .ToList();
                    return new OwnerWorkload(owner, total, segments);
                })
                .OrderBy(g => g.Owner != "Unassigned" ? 1 : 0)
                .ThenBy(g => g.Owner)
                .ToList();
        }
    }
}
